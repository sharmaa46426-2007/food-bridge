# FoodBridge Environment Configuration

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Secret (DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Timezone & Region
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_MEASUREMENT_SYSTEM=metric

# Optional Email Integration (e.g. Resend)
RESEND_API_KEY=
EMAIL_FROM=notifications@foodbridge.org
